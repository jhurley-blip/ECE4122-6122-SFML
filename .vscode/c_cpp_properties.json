{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/shared_lib/include",
                "/usr/include",
                "/usr/local/include"
            ],
            "defines": [
                "DEBUG_MODE"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",

            // This tells the C/C++ extension to get its configuration
            // from CMake Tools instead of using the settings above.
            // The above settings serve as fallbacks if CMake Tools
            // is not configured yet.
            "configurationProvider": "ms-vscode.cmake-tools",

            // Path to compile_commands.json generated by CMake
            // (enabled by CMAKE_EXPORT_COMPILE_COMMANDS=ON)
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json"
        }
    ],
    "version": 4
}
